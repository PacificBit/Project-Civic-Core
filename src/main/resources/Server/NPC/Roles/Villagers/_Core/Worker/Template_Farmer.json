{
  "Type": "Abstract",
  "Parameters": {
    "NameTranslationKey": {
      "Value": "server.npcRoles.Template.name",
      "Description": "Translation key for NPC name display"
    },
    "Appearance": {
      "Value": "Player",
      "Description": "Model to be used"
    },
    "MaxHealth": {
      "Value": 100,
      "Description": "Max health for the NPC"
    },
    "DropList": {
      "Value": "Empty",
      "Description": "Drop Items"
    },
    "FirstWorkSessionTimeRange": {
      "Value": [
        6,
        11.59
      ],
      "Description": "Time range of the first session"
    },
    "SecondWorkSessionTimeRange": {
      "Value": [
        14,
        16.59
      ],
      "Description": "Time range of the second session"
    }
  },
  "MotionControllerList": [
    {
      "Type": "Walk",
      "MaxWalkSpeed": 6,
      "Gravity": 10,
      "MaxFallSpeed": 15,
      "Acceleration": 10
    }
  ],
  "Instructions": [
    {
      "Sensor": {
        "Type": "Not",
        "Sensor": {
          "Type": "WatchForJobAssignment"
        }
      },
      "Instructions": [
        {
          "Sensor": {
            "Type": "Any"
          },
          "Continue": true,
          "Actions": [
            {
              "Type": "EquipItemFromInventory",
              "ItemToEquip": "NULL"
            }
          ],
          "$Comment": "Empty the hand"
        },
        {
          "Sensor": {
            "Type": "Any"
          },
          "Actions": [
            {
              "Type": "Role",
              "Role": "Base_Civilian",
              "ChangeAppearance": false,
              "State": "Normal"
            }
          ],
          "$Comment": "Change State -> Base_Civilian.Panic"
        }
      ],
      "Continue": true,
      "$Comment": "Check if job was removed"
    },
    {
      "Sensor": {
        "Type": "WatchVillageState",
        "State": "panic"
      },
      "Instructions": [
        {
          "Sensor": {
            "Type": "Any"
          },
          "Continue": true,
          "Actions": [
            {
              "Type": "EquipItemFromInventory",
              "ItemToEquip": "NULL"
            }
          ],
          "$Comment": "Empty the hand"
        },
        {
          "Sensor": {
            "Type": "Any"
          },
          "Actions": [
            {
              "Type": "Role",
              "Role": "Base_Civilian",
              "ChangeAppearance": false,
              "State": "Panic"
            }
          ],
          "$Comment": "Change State -> Base_Civilian.Panic"
        }
      ],
      "Continue": true,
      "$Comment": "If the village is in panic"
    },
    {
      "Sensor": {
        "Type": "And",
        "Sensors": [
          {
            "Type": "Not",
            "Sensor": {
              "Type": "TimeInRange",
              "Period": {
                "Compute": "FirstWorkSessionTimeRange"
              }
            }
          },
          {
            "Type": "Not",
            "Sensor": {
              "Type": "TimeInRange",
              "Period": {
                "Compute": "SecondWorkSessionTimeRange"
              }
            }
          }
        ]
      },
      "$Comment": "If is not work time",
      "Instructions": [
        {
          "Sensor": {
            "Type": "Any"
          },
          "Continue": true,
          "Actions": [
            {
              "Type": "EquipItemFromInventory",
              "ItemToEquip": "NULL"
            }
          ],
          "$Comment": "Empty the hand"
        },
        {
          "Sensor": {
            "Type": "Any"
          },
          "Actions": [
            {
              "Type": "Role",
              "Role": "Base_Civilian",
              "ChangeAppearance": false,
              "State": "Normal"
            }
          ],
          "$Comment": "Change State -> Base_Civilian.Normal"
        }
      ],
      "Continue": true
    },
    {
      "Sensor": {
        "Type": "State",
        "State": "Working"
      },
      "Instructions": [
        {
          "Sensor": {
            "Type": "State",
            "State": ".Default"
          },
          "Actions": [
            {
              "Type": "State",
              "State": ".ReachWorkplace"
            }
          ],
          "$Comment": "Entry point"
        },
        {
          "Sensor": {
            "Type": "State",
            "State": ".ReachWorkplace"
          },
          "Instructions": [
            {
              "Sensor": {
                "Type": "ReachWorkplace",
                "StoppingRange": 1
              },
              "Actions": [
                {
                  "Type": "PlayAnimation",
                  "Slot": "Action",
                  "Animation": "Walk",
                  "Once": true
                }
              ],
              "BodyMotion": {
                "Type": "Seek",
                "SlowDownDistance": 1,
                "StopDistance": 0.8,
                "RelativeSpeed": 1
              },
              "Continue": false,
              "$Comment": "Reaching workplace"
            },
            {
              "Sensor": {
                "Type": "Not",
                "Sensor": {
                  "Type": "HasValidWorkAraSnapshot"
                }
              },
              "Instructions": [
                {
                  "Sensor": {
                    "Type": "Any"
                  },
                  "Actions": [
                    {
                      "Type": "State",
                      "State": ".NoWorkingAreaSnapshot"
                    }
                  ],
                  "$Comment": "Change Substate: Default -> .NoWorkingAreaSnapshot",
                  "Continue": true
                }
              ],
              "$Comment": "No valid work area snapshot",
              "Continue": true
            },
            {
              "Sensor": {
                "Type": "Any"
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": ".WorkLoop"
                }
              ],
              "$Comment": "Workplace Reached -> .StartWork"
            }
          ],
          "$Comment": "Starting the workday"
        },
        {
          "Sensor": {
            "Type": "State",
            "State": ".WorkLoop"
          },
          "Instructions": [
            {
              "Sensor": {
                "Type": "HasTargetBlockInSnapshot",
                "TargetBlockIds": [
                  "Tillable_Terrain"
                ]
              },
              "$Comment": "Step 1) Till Soil",
              "Instructions": [
                {
                  "Sensor": {
                    "Type": "Not",
                    "Sensor": {
                      "Type": "Self",
                      "Filters": [
                        {
                          "Type": "Inventory",
                          "Items": [
                            "Village_Tool_Hoe_*"
                          ]
                        }
                      ]
                    }
                  },
                  "Instructions": [
                    {
                      "Sensor": {
                        "Type": "Any"
                      },
                      "Actions": [
                        {
                          "Type": "State",
                          "State": "RequestStorage.Hoe"
                        }
                      ],
                      "$Comment": "Clear Snapshot data of Plantable_Terrain"
                    }
                  ],
                  "$Comment": "If has NO Hoe in inventory"
                },
                {
                  "Sensor": {
                    "Type": "Any"
                  },
                  "Instructions": [
                    {
                      "Sensor": {
                        "Type": "Any"
                      },
                      "Actions": [
                        {
                          "Type": "EquipItemFromInventory",
                          "ItemToEquip": "Village_Tool_Hoe_"
                        }
                      ],
                      "$Comment": "Equip Hoe",
                      "Continue": true
                    },
                    {
                      "Sensor": {
                        "Type": "ReachNextTargetInSnapshot",
                        "BlockIds": [
                          "Tillable_Terrain"
                        ],
                        "StoppingRange": 1.3,
                        "UseCenterOfBlock": true
                      },
                      "$Comment": "Reach Tillable Block",
                      "BodyMotion": {
                        "Type": "Seek",
                        "StopDistance": 0.5,
                        "SlowDownDistance": 0.5,
                        "RelativeSpeed": 0.7
                      }
                    },
                    {
                      "Sensor": {
                        "Type": "Any"
                      },
                      "Actions": [
                        {
                          "Type": "Timeout",
                          "Delay": [
                            0.5,
                            0.6
                          ],
                          "Action": {
                            "Type": "TillSoilAction"
                          }
                        }
                      ]
                    }
                  ],
                  "$Comment": "If has Hoe in Inventory"
                }
              ]
            },
            {
              "Sensor": {
                "Type": "HasTargetBlockInSnapshot",
                "TargetBlockIds": [
                  "Plantable_Terrain"
                ]
              },
              "$Comment": "Step 2) Can Plant",
              "Instructions": [
                {
                  "Sensor": {
                    "Type": "Not",
                    "Sensor": {
                      "Type": "Self",
                      "Filters": [
                        {
                          "Type": "Inventory",
                          "Items": [
                            "Plant_Seeds*"
                          ]
                        }
                      ]
                    }
                  },
                  "Instructions": [
                    {
                      "Sensor": {
                        "Type": "Any"
                      },
                      "Actions": [
                        {
                          "Type": "State",
                          "State": "RequestStorage.Seeds"
                        }
                      ],
                      "$Comment": "Clear Snapshot data of Plantable_Terrain"
                    }
                  ],
                  "$Comment": "If has NO Seeds in inventory"
                },
                {
                  "Sensor": {
                    "Type": "Any"
                  },
                  "$Comment": "If has Seeds in Inventory",
                  "Instructions": [
                    {
                      "Sensor": {
                        "Type": "Any"
                      },
                      "Actions": [
                        {
                          "Type": "EquipItemFromInventory",
                          "ItemToEquip": "Plant_Seeds"
                        }
                      ],
                      "Continue": true
                    },
                    {
                      "Sensor": {
                        "Type": "ReachNextTargetInSnapshot",
                        "BlockIds": [
                          "Plantable_Terrain"
                        ],
                        "StoppingRange": 1,
                        "UseCenterOfBlock": true
                      },
                      "$Comment": "Reach Plantable Block",
                      "BodyMotion": {
                        "Type": "Seek",
                        "StopDistance": 0.5,
                        "SlowDownDistance": 0.5,
                        "RelativeSpeed": 0.7
                      },
                      "HeadMotion": {
                        "Type": "Observe",
                        "AngleRange": [
                          0,
                          0
                        ]
                      }
                    },
                    {
                      "Sensor": {
                        "Type": "Any"
                      },
                      "Actions": [
                        {
                          "Type": "Timeout",
                          "Delay": [
                            0.5,
                            0.6
                          ],
                          "Action": {
                            "Type": "PlantSeedAction"
                          }
                        }
                      ]
                    }
                  ]
                }
              ],
              "Continue": false
            },
            {
              "Sensor": {
                "Type": "HasTargetBlockInSnapshot",
                "TargetBlockIds": [
                  "Harvestable_Crop"
                ]
              },
              "$Comment": "Step 3) Harvest Crops",
              "Instructions": [
                {
                  "Sensor": {
                    "Type": "ReachNextTargetInSnapshot",
                    "BlockIds": [
                      "Harvestable_Crop"
                    ],
                    "StoppingRange": 1,
                    "UseCenterOfBlock": true
                  },
                  "$Comment": "Reach Plantable Block",
                  "BodyMotion": {
                    "Type": "Seek",
                    "StopDistance": 0.5,
                    "SlowDownDistance": 0.5,
                    "RelativeSpeed": 0.7
                  }
                },
                {
                  "Sensor": {
                    "Type": "Any"
                  },
                  "Actions": [
                    {
                      "Type": "Timeout",
                      "Delay": [
                        1,
                        1
                      ],
                      "Action": {
                        "Type": "HarvestCrop"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "Sensor": {
                "Type": "HasTargetBlockInSnapshot",
                "TargetBlockIds": [
                  "Waterable_Terrain"
                ]
              },
              "$Comment": "Step 4) Water Field",
              "Instructions": [
                {
                  "Sensor": {
                    "Type": "Not",
                    "Sensor": {
                      "Type": "Self",
                      "Filters": [
                        {
                          "Type": "Inventory",
                          "Items": [
                            "Village_Tool_Watering_Can"
                          ]
                        }
                      ]
                    }
                  },
                  "Instructions": [
                    {
                      "Sensor": {
                        "Type": "Any"
                      },
                      "Actions": [
                        {
                          "Type": "State",
                          "State": "RequestStorage.WateringCan"
                        }
                      ],
                      "$Comment": "Clear Snapshot data of Plantable_Terrain"
                    }
                  ],
                  "$Comment": "If has NO Watering Can in inventory"
                },
                {
                  "Sensor": {
                    "Type": "Any"
                  },
                  "$Comment": "If has Watering Can",
                  "Instructions": [
                    {
                      "Sensor": {
                        "Type": "Any"
                      },
                      "Actions": [
                        {
                          "Type": "EquipItemFromInventory",
                          "ItemToEquip": "Village_Tool_Watering_Can"
                        }
                      ],
                      "$Comment": "Equip Watering Can",
                      "Continue": true
                    },
                    {
                      "Sensor": {
                        "Type": "ReachNextTargetInSnapshot",
                        "BlockIds": [
                          "Waterable_Terrain"
                        ],
                        "StoppingRange": 1.5,
                        "UseCenterOfBlock": true
                      },
                      "$Comment": "Reach Tillable Block",
                      "BodyMotion": {
                        "Type": "Seek",
                        "StopDistance": 0.5,
                        "SlowDownDistance": 0.5,
                        "RelativeSpeed": 0.7
                      }
                    },
                    {
                      "Sensor": {
                        "Type": "Any"
                      },
                      "Actions": [
                        {
                          "Type": "Timeout",
                          "Delay": [
                            1,
                            1
                          ],
                          "Action": {
                            "Type": "WaterSoil"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "Sensor": {
                "Type": "Any"
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": "WorkCooldown"
                }
              ]
            }
          ]
        },
        {
          "Sensor": {
            "Type": "State",
            "State": ".NoWorkingAreaSnapshot"
          },
          "$Comment": "Needs to process the working enviroment",
          "Instructions": [
            {
              "Sensor": {
                "Type": "Not",
                "Sensor": {
                  "Type": "HasValidWorkAraSnapshot"
                }
              },
              "Actions": [
                {
                  "Type": "ScanWorkArea"
                }
              ],
              "$Comment": "If not valid work area snapshot is present"
            },
            {
              "Sensor": {
                "Type": "Any"
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": ".WorkLoop"
                }
              ],
              "$Comment": "Change Substate: -> .WorkLoop"
            }
          ]
        }
      ],
      "Continue": true,
      "$Comment": "Work Process"
    },
    {
      "Sensor": {
        "Type": "State",
        "State": "RequestStorage"
      },
      "$Comment": "Storage request",
      "Instructions": [
        {
          "Sensor": {
            "Type": "State",
            "State": ".Seeds"
          },
          "Instructions": [
            {
              "Sensor": {
                "Type": "Not",
                "Sensor": {
                  "Type": "HasTargetBlockInSnapshot",
                  "TargetBlockIds": [
                    "Worker_Workplace_Storage"
                  ]
                },
                "Once": true
              },
              "$Comment": "If the positions of the workplace containers are not in snapshot",
              "Instructions": [
                {
                  "Sensor": {
                    "Type": "Any"
                  },
                  "$Comment": "Add to snapshot the containers",
                  "Actions": [
                    {
                      "Type": "SetWorkplaceStorageTargetInSnapshot",
                      "ActionType": "ADD"
                    }
                  ]
                }
              ]
            },
            {
              "Sensor": {
                "Type": "ReachNextTargetInSnapshot",
                "BlockIds": [
                  "Worker_Workplace_Storage"
                ],
                "StoppingRange": 0.6
              },
              "$Comment": "Reach workplace storage container",
              "BodyMotion": {
                "Type": "Seek",
                "SlowDownDistance": 1.5,
                "StopDistance": 0.6,
                "RelativeSpeed": 0.6
              }
            },
            {
              "Sensor": {
                "Type": "Any",
                "Once": true
              },
              "$Comment": "Try to fetch materials",
              "Actions": [
                {
                  "Type": "InteractWithExternalInventory",
                  "ActionType": "WITHDRAW",
                  "SnapshotKey": "Worker_Workplace_Storage",
                  "ConsumeTargetOnFail": true,
                  "ItemCriteria": [
                    {
                      "ItemId": "*Seeds*",
                      "FilterIn": true,
                      "Count": -1
                    },
                    {
                      "ItemId": "Ingredient_Life_Essence*",
                      "FilterIn": true,
                      "Count": -1
                    }
                  ]
                }
              ]
            },
            {
              "Sensor": {
                "Type": "Self",
                "Filters": [
                  {
                    "Type": "Inventory",
                    "Items": [
                      "Plant_Seeds*"
                    ]
                  }
                ],
                "Once": true
              },
              "$Comment": "If now has Seeds in inventory",
              "Actions": [
                {
                  "Type": "State",
                  "State": "Working.WorkLoop"
                }
              ]
            },
            {
              "Sensor": {
                "Type": "Self",
                "Filters": [
                  {
                    "Type": "Inventory",
                    "Items": [
                      "Ingredient_Life_Essence*"
                    ]
                  }
                ],
                "Once": true
              },
              "$Comment": "If now has Ingredient_Life_Essence in inventory",
              "Actions": [
                {
                  "Type": "State",
                  "State": "Craft.Seeds"
                }
              ]
            },
            {
              "Sensor": {
                "Type": "Any"
              },
              "Actions": [
                {
                  "Type": "SetMissingResources",
                  "ItemCriteria": [
                    {
                      "ItemId": "*Seeds*",
                      "FilterIn": true,
                      "Count": 100
                    },
                    {
                      "ItemId": "Ingredient_Life_Essence*",
                      "FilterIn": true,
                      "Count": 100
                    }
                  ],
                  "ResetMissingResources": true
                },
                {
                  "Type": "AskStorageToDeliveResources",
                  "SourceType": "WORKPLACE"
                },
                {
                  "Type": "State",
                  "State": ".WaitForSeedsResource"
                }
              ],
              "$Comment": "Set missing resources"
            }
          ]
        },
        {
          "Sensor": {
            "Type": "State",
            "State": ".WaitForSeedsResource"
          },
          "Instructions": [
            {
              "Sensor": {
                "Type": "Not",
                "Sensor": {
                  "Type": "HasStoragePendingRequest"
                }
              },
              "$Comment": "If no pending request",
              "Actions": [
                {
                  "Type": "State",
                  "State": ".Seeds"
                }
              ]
            }
          ]
        },
        {
          "Sensor": {
            "Type": "State",
            "State": ".Hoe"
          },
          "Instructions": [
            {
              "Sensor": {
                "Type": "Not",
                "Sensor": {
                  "Type": "HasTargetBlockInSnapshot",
                  "TargetBlockIds": [
                    "Worker_Workplace_Storage"
                  ]
                },
                "Once": true
              },
              "$Comment": "If the positions of the workplace containers are not in snapshot",
              "Instructions": [
                {
                  "Sensor": {
                    "Type": "Any"
                  },
                  "$Comment": "Add to snapshot the containers",
                  "Actions": [
                    {
                      "Type": "SetWorkplaceStorageTargetInSnapshot",
                      "ActionType": "ADD"
                    }
                  ]
                }
              ]
            },
            {
              "Sensor": {
                "Type": "ReachNextTargetInSnapshot",
                "BlockIds": [
                  "Worker_Workplace_Storage"
                ],
                "StoppingRange": 0.6
              },
              "$Comment": "Reach workplace storage container",
              "BodyMotion": {
                "Type": "Seek",
                "SlowDownDistance": 1.5,
                "StopDistance": 0.6,
                "RelativeSpeed": 0.6
              }
            },
            {
              "Sensor": {
                "Type": "Any",
                "Once": true
              },
              "$Comment": "Try to fetch materials",
              "Actions": [
                {
                  "Type": "InteractWithExternalInventory",
                  "ActionType": "WITHDRAW",
                  "SnapshotKey": "Worker_Workplace_Storage",
                  "ConsumeTargetOnFail": true,
                  "ItemCriteria": [
                    {
                      "ItemId": "*Hoe*",
                      "FilterIn": true,
                      "Count": -1
                    },
                    {
                      "ItemId": "Ingredient_Life_Essence*",
                      "FilterIn": true,
                      "Count": -1
                    }
                  ]
                }
              ]
            },
            {
              "Sensor": {
                "Type": "Self",
                "Filters": [
                  {
                    "Type": "Inventory",
                    "Items": [
                      "*Hoe*"
                    ]
                  }
                ],
                "Once": true
              },
              "$Comment": "If now has Hoe in inventory",
              "Actions": [
                {
                  "Type": "State",
                  "State": "Working.WorkLoop"
                }
              ]
            },
            {
              "Sensor": {
                "Type": "Self",
                "Filters": [
                  {
                    "Type": "Inventory",
                    "Items": [
                      "Ingredient_Life_Essence*"
                    ]
                  }
                ],
                "Once": true
              },
              "$Comment": "If now has Ingredient_Life_Essence in inventory",
              "Actions": [
                {
                  "Type": "State",
                  "State": "Craft.Hoe"
                }
              ]
            },
            {
              "Sensor": {
                "Type": "Any"
              },
              "Actions": [
                {
                  "Type": "SetMissingResources",
                  "ItemCriteria": [
                    {
                      "ItemId": "*Hoe*",
                      "FilterIn": true,
                      "Count": 1
                    },
                    {
                      "ItemId": "Ingredient_Life_Essence*",
                      "FilterIn": true,
                      "Count": 20
                    }
                  ],
                  "ResetMissingResources": true
                },
                {
                  "Type": "AskStorageToDeliveResources",
                  "SourceType": "WORKPLACE"
                },
                {
                  "Type": "State",
                  "State": ".WaitForHoeResource"
                }
              ],
              "$Comment": "Set missing resources"
            }
          ]
        },
        {
          "Sensor": {
            "Type": "State",
            "State": ".WaitForHoeResource"
          },
          "Instructions": [
            {
              "Sensor": {
                "Type": "Not",
                "Sensor": {
                  "Type": "HasStoragePendingRequest"
                }
              },
              "$Comment": "If no pending request",
              "Actions": [
                {
                  "Type": "State",
                  "State": ".Hoe"
                }
              ]
            }
          ]
        },
        {
          "Sensor": {
            "Type": "State",
            "State": ".WateringCan"
          },
          "Instructions": [
            {
              "Sensor": {
                "Type": "Not",
                "Sensor": {
                  "Type": "HasTargetBlockInSnapshot",
                  "TargetBlockIds": [
                    "Worker_Workplace_Storage"
                  ]
                },
                "Once": true
              },
              "$Comment": "If the positions of the workplace containers are not in snapshot",
              "Instructions": [
                {
                  "Sensor": {
                    "Type": "Any"
                  },
                  "$Comment": "Add to snapshot the containers",
                  "Actions": [
                    {
                      "Type": "SetWorkplaceStorageTargetInSnapshot",
                      "ActionType": "ADD"
                    }
                  ]
                }
              ]
            },
            {
              "Sensor": {
                "Type": "ReachNextTargetInSnapshot",
                "BlockIds": [
                  "Worker_Workplace_Storage"
                ],
                "StoppingRange": 0.6
              },
              "$Comment": "Reach workplace storage container",
              "BodyMotion": {
                "Type": "Seek",
                "SlowDownDistance": 1.5,
                "StopDistance": 0.6,
                "RelativeSpeed": 0.6
              }
            },
            {
              "Sensor": {
                "Type": "Any",
                "Once": true
              },
              "$Comment": "Try to fetch materials",
              "Actions": [
                {
                  "Type": "InteractWithExternalInventory",
                  "ActionType": "WITHDRAW",
                  "SnapshotKey": "Worker_Workplace_Storage",
                  "ConsumeTargetOnFail": true,
                  "ItemCriteria": [
                    {
                      "ItemId": "Village_Tool_Watering_Can*",
                      "FilterIn": true,
                      "Count": -1
                    },
                    {
                      "ItemId": "Ingredient_Life_Essence*",
                      "FilterIn": true,
                      "Count": -1
                    }
                  ]
                }
              ]
            },
            {
              "Sensor": {
                "Type": "Self",
                "Filters": [
                  {
                    "Type": "Inventory",
                    "Items": [
                      "Village_Tool_Watering_Can*"
                    ]
                  }
                ],
                "Once": true
              },
              "$Comment": "If now has Watering Can in inventory",
              "Actions": [
                {
                  "Type": "State",
                  "State": "Working.WorkLoop"
                }
              ]
            },
            {
              "Sensor": {
                "Type": "Self",
                "Filters": [
                  {
                    "Type": "Inventory",
                    "Items": [
                      "Ingredient_Life_Essence*"
                    ]
                  }
                ],
                "Once": true
              },
              "$Comment": "If now has Ingredient_Life_Essence in inventory",
              "Actions": [
                {
                  "Type": "State",
                  "State": "Craft.WateringCan"
                }
              ]
            },
            {
              "Sensor": {
                "Type": "Any"
              },
              "Actions": [
                {
                  "Type": "SetMissingResources",
                  "ItemCriteria": [
                    {
                      "ItemId": "Village_Tool_Watering_Can*",
                      "FilterIn": true,
                      "Count": 1
                    },
                    {
                      "ItemId": "Ingredient_Life_Essence*",
                      "FilterIn": true,
                      "Count": 20
                    }
                  ],
                  "ResetMissingResources": true
                },
                {
                  "Type": "AskStorageToDeliveResources",
                  "SourceType": "WORKPLACE"
                },
                {
                  "Type": "State",
                  "State": ".WaitForWateringCanResource"
                }
              ],
              "$Comment": "Set missing resources"
            }
          ]
        },
        {
          "Sensor": {
            "Type": "State",
            "State": ".WaitForWateringCanResource"
          },
          "Instructions": [
            {
              "Sensor": {
                "Type": "Not",
                "Sensor": {
                  "Type": "HasStoragePendingRequest"
                }
              },
              "$Comment": "If no pending request",
              "Actions": [
                {
                  "Type": "State",
                  "State": ".WateringCan"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "Sensor": {
        "Type": "State",
        "State": "Craft"
      },
      "$Comment": "Storage request",
      "Instructions": [
        {
          "Sensor": {
            "Type": "State",
            "State": ".Seeds"
          },
          "Actions": [
            {
              "Type": "Log",
              "Message": "CRAFTING SEEDS"
            },
            {
              "Type": "CraftSeeds"
            },
            {
              "Type": "Timeout",
              "Delay": [
                4,
                6
              ],
              "Action": {
                "Type": "State",
                "State": "PostWorkCooldown"
              }
            }
          ]
        },
        {
          "Sensor": {
            "Type": "State",
            "State": ".Hoe"
          },
          "Actions": [
            {
              "Type": "Log",
              "Message": "CRAFTING HOE"
            },
            {
              "Type": "CraftTool",
              "ToolType": "HOE",
              "Once": true
            },
            {
              "Type": "Timeout",
              "Delay": [
                4,
                6
              ],
              "Action": {
                "Type": "State",
                "State": "PostWorkCooldown"
              }
            }
          ]
        },
        {
          "Sensor": {
            "Type": "State",
            "State": ".WateringCan"
          },
          "Actions": [
            {
              "Type": "Log",
              "Message": "CRAFTING WATERING CAN"
            },
            {
              "Type": "CraftTool",
              "ToolType": "WATERING_CAN",
              "Once": true
            },
            {
              "Type": "Timeout",
              "Delay": [
                4,
                6
              ],
              "Action": {
                "Type": "State",
                "State": "PostWorkCooldown"
              }
            }
          ]
        }
      ]
    },
    {
      "Sensor": {
        "Type": "State",
        "State": "WorkCooldown"
      },
      "$Comment": "After all the steps are done",
      "Instructions": [
        {
          "Sensor": {
            "Type": "Any"
          },
          "Continue": true,
          "Actions": [
            {
              "Type": "EquipItemFromInventory",
              "ItemToEquip": "NULL"
            }
          ],
          "$Comment": "Empty the hand"
        },
        {
          "Sensor": {
            "Type": "QueryDirtyInventorySensor",
            "ExcludeItemTypes": [
              "*Watering_Can",
              "Village_Tool_Hoe*",
              "*Seeds*"
            ]
          },
          "$Comment": "If has a dirty inventory",
          "Instructions": [
            {
              "Sensor": {
                "Type": "Not",
                "Sensor": {
                  "Type": "HasTargetBlockInSnapshot",
                  "TargetBlockIds": [
                    "Worker_Workplace_Storage"
                  ]
                },
                "Once": true
              },
              "$Comment": "If the positions of the workplace containers are not in snapshot",
              "Instructions": [
                {
                  "Sensor": {
                    "Type": "Any"
                  },
                  "$Comment": "Add to snapshot the containers",
                  "Actions": [
                    {
                      "Type": "SetWorkplaceStorageTargetInSnapshot",
                      "ActionType": "ADD"
                    }
                  ]
                }
              ]
            },
            {
              "Sensor": {
                "Type": "ReachNextTargetInSnapshot",
                "BlockIds": [
                  "Worker_Workplace_Storage"
                ],
                "StoppingRange": 1.5
              },
              "$Comment": "Reach workplace storage container",
              "BodyMotion": {
                "Type": "Seek",
                "SlowDownDistance": 1.5,
                "StopDistance": 1.5,
                "RelativeSpeed": 0.6
              }
            },
            {
              "Sensor": {
                "Type": "Any"
              },
              "$Comment": "Try to deposit & Send clear storage request",
              "Actions": [
                {
                  "Type": "InteractWithExternalInventory",
                  "ActionType": "DEPOSIT",
                  "SnapshotKey": "Worker_Workplace_Storage",
                  "ConsumeTargetOnFail": true,
                  "ItemCriteria": [
                    {
                      "ItemId": "Village_Tool_Hoe*",
                      "FilterIn": false,
                      "Count": -1
                    },
                    {
                      "ItemId": "Village_Tool_Watering_Can*",
                      "FilterIn": false,
                      "Count": -1
                    },
                    {
                      "ItemId": "*Seeds*",
                      "FilterIn": false,
                      "Count": -1
                    }
                  ]
                },
                {
                  "Type": "AskClearWorkplaceStorage",
                  "ExcludedItemTypes": [
                    "Village_Tool_Hoe*",
                    "*Seeds*",
                    "Village_Tool_Watering_Can"
                  ],
                  "Once": true
                }
              ]
            },
            {
              "Sensor": {
                "Type": "Any"
              },
              "$Comment": "If it was not able to deposit: Send clear storage request",
              "Actions": [
                {
                  "Type": "AskClearWorkplaceStorage",
                  "ExcludedItemTypes": [
                    "Village_Tool_Hoe*",
                    "*Seeds*",
                    "Village_Tool_Watering_Can"
                  ],
                  "Once": true
                }
              ]
            }
          ]
        },
        {
          "Sensor": {
            "Type": "Any"
          },
          "$Comment": "Cooldown",
          "ActionsBlocking": true,
          "ActionsAtomic": true,
          "Actions": [
            {
              "Type": "Timeout",
              "Delay": [
                25,
                25
              ],
              "Action": {
                "Type": "State",
                "State": "PostWorkCooldown"
              }
            }
          ]
        }
      ]
    },
    {
      "Sensor": {
        "Type": "State",
        "State": "PostWorkCooldown"
      },
      "$Comment": "Post Cooldown Creating Snapshot Area",
      "Instructions": [
        {
          "Sensor": {
            "Type": "Any"
          },
          "Actions": [
            {
              "Type": "ScanWorkArea"
            }
          ],
          "Continue": true,
          "$Comment": "Scan Work Area"
        },
        {
          "Sensor": {
            "Type": "Any"
          },
          "Actions": [
            {
              "Type": "State",
              "State": "Working.WorkLoop"
            }
          ],
          "$Comment": "Start work loop"
        }
      ]
    }
  ],
  "NameTranslationKey": {
    "Compute": "NameTranslationKey"
  },
  "StartState": "Working",
  "Appearance": {
    "Compute": "Appearance"
  },
  "MaxHealth": {
    "Compute": "MaxHealth"
  }
}
