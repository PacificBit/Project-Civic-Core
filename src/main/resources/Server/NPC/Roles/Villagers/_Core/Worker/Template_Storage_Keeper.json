{
  "Type": "Abstract",
  "Parameters": {
    "Appearance": {
      "Value": "Player",
      "Description": "Model to be used"
    },
    "DropList": {
      "Value": "Empty",
      "Description": "Drop Items"
    },
    "MaxHealth": {
      "Value": 100,
      "Description": "Max health for the NPC"
    },
    "NameTranslationKey": {
      "Value": "server.npcRoles.Template.name",
      "Description": "Translation key for NPC name display"
    },
    "FirstWorkSessionTimeRange": {
      "Value": [
        6,
        11.59
      ],
      "Description": "Time range of the first session"
    },
    "SecondWorkSessionTimeRange": {
      "Value": [
        14,
        16.59
      ],
      "Description": "Time range of the second session"
    }
  },
  "DropList": {
    "Compute": "DropList"
  },
  "MotionControllerList": [
    {
      "Type": "Walk",
      "MaxWalkSpeed": 6,
      "Gravity": 10,
      "MaxFallSpeed": 15,
      "Acceleration": 10
    }
  ],
  "Instructions": [
    {
      "Sensor": {
        "Type": "Not",
        "Sensor": {
          "Type": "WatchForJobAssignment"
        }
      },
      "Instructions": [
        {
          "Sensor": {
            "Type": "Any"
          },
          "Actions": [
            {
              "Type": "Role",
              "Role": "Base_Civilian",
              "ChangeAppearance": false,
              "State": "Normal"
            }
          ],
          "$Comment": "Change State -> Base_Civilian.Panic"
        }
      ],
      "Continue": true,
      "$Comment": "Check if job was removed"
    },
    {
      "Sensor": {
        "Type": "WatchVillageState",
        "State": "panic"
      },
      "Instructions": [
        {
          "Sensor": {
            "Type": "Any"
          },
          "Actions": [
            {
              "Type": "Role",
              "Role": "Base_Civilian",
              "ChangeAppearance": false,
              "State": "Panic"
            }
          ],
          "$Comment": "Change State -> Base_Civilian.Panic"
        }
      ],
      "Continue": true,
      "$Comment": "If the village is in panic"
    },
    {
      "Sensor": {
        "Type": "And",
        "Sensors": [
          {
            "Type": "Not",
            "Sensor": {
              "Type": "TimeInRange",
              "Period": {
                "Compute": "FirstWorkSessionTimeRange"
              }
            }
          },
          {
            "Type": "Not",
            "Sensor": {
              "Type": "TimeInRange",
              "Period": {
                "Compute": "SecondWorkSessionTimeRange"
              }
            }
          }
        ]
      },
      "$Comment": "If is not work time",
      "Instructions": [
        {
          "Sensor": {
            "Type": "Any"
          },
          "Actions": [
            {
              "Type": "Role",
              "Role": "Base_Civilian",
              "ChangeAppearance": false,
              "State": "Normal"
            }
          ],
          "$Comment": "Change State -> Base_Civilian.Normal"
        }
      ],
      "Continue": true
    },
    {
      "Sensor": {
        "Type": "State",
        "State": "Working"
      },
      "Instructions": [
        {
          "Sensor": {
            "Type": "State",
            "State": ".Default"
          },
          "Actions": [
            {
              "Type": "State",
              "State": ".ReachWorkplace"
            }
          ],
          "$Comment": "Entry point"
        },
        {
          "Sensor": {
            "Type": "State",
            "State": ".ReachWorkplace"
          },
          "Instructions": [
            {
              "Sensor": {
                "Type": "ReachWorkplace",
                "StoppingRange": 1
              },
              "Actions": [
                {
                  "Type": "PlayAnimation",
                  "Slot": "Action",
                  "Animation": "Walk",
                  "Once": true
                }
              ],
              "BodyMotion": {
                "Type": "Seek",
                "SlowDownDistance": 1,
                "StopDistance": 0.8,
                "RelativeSpeed": 1
              },
              "Continue": false,
              "$Comment": "Reaching workplace"
            },
            {
              "Sensor": {
                "Type": "Not",
                "Sensor": {
                  "Type": "HasValidWorkAraSnapshot"
                }
              },
              "Instructions": [
                {
                  "Sensor": {
                    "Type": "Any"
                  },
                  "Actions": [
                    {
                      "Type": "State",
                      "State": ".NoWorkingAreaSnapshot"
                    }
                  ],
                  "$Comment": "Change Substate: Default -> .NoWorkingAreaSnapshot",
                  "Continue": true
                }
              ],
              "$Comment": "No valid work area snapshot",
              "Continue": true
            },
            {
              "Sensor": {
                "Type": "Any"
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": ".PreWorkLoop"
                }
              ],
              "$Comment": "Workplace Reached -> .PreWorkLoop"
            }
          ],
          "$Comment": "Starting the workday"
        },
        {
          "Sensor": {
            "Type": "State",
            "State": ".PreWorkLoop"
          },
          "$Comment": "Pre WorkLoop - clear inventory",
          "Instructions": [
            {
              "Sensor": {
                "Type": "QueryDirtyInventorySensor"
              },
              "Instructions": [
                {
                  "Sensor": {
                    "Type": "Not",
                    "Sensor": {
                      "Type": "HasTargetBlockInSnapshot",
                      "TargetBlockIds": [
                        "Worker_Workplace_Storage"
                      ]
                    },
                    "Once": true
                  },
                  "Instructions": [
                    {
                      "Sensor": {
                        "Type": "Any"
                      },
                      "Actions": [
                        {
                          "Type": "SetWorkplaceStorageTargetInSnapshot",
                          "ActionType": "ADD"
                        }
                      ],
                      "$Comment": "Add to snapshot"
                    }
                  ],
                  "$Comment": "If the position of the workplace containers are not in snapshot"
                },
                {
                  "Sensor": {
                    "Type": "ReachNextTargetInSnapshot",
                    "BlockIds": [
                      "Worker_Workplace_Storage"
                    ],
                    "StoppingRange": 1.5
                  },
                  "BodyMotion": {
                    "Type": "Seek",
                    "StopDistance": 1.5,
                    "SlowDownDistance": 1.5,
                    "RelativeSpeed": 0.6
                  },
                  "$Comment": "Reach workplace storage container"
                },
                {
                  "Sensor": {
                    "Type": "Any"
                  },
                  "Actions": [
                    {
                      "Type": "InteractWithExternalInventory",
                      "ActionType": "DEPOSIT",
                      "SnapshotKey": "Worker_Workplace_Storage",
                      "ConsumeTargetOnFail": true
                    }
                  ],
                  "$Comment": "Try to deposit all"
                }
              ],
              "$Comment": "If the inventory is not empty"
            },
            {
              "Sensor": {
                "Type": "Any"
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": ".WorkLoop"
                }
              ],
              "$Comment": "Substate change: -> .WorkLoop"
            }
          ]
        },
        {
          "Sensor": {
            "Type": "State",
            "State": ".WorkLoop"
          },
          "Instructions": [
            {
              "Sensor": {
                "Type": "HasTargetBlockInSnapshot",
                "TargetBlockIds": [
                  "Fetch_All"
                ]
              },
              "Instructions": [
                {
                  "Sensor": {
                    "Type": "ReachNextTargetInSnapshot",
                    "BlockIds": [
                      "Fetch_All"
                    ],
                    "StoppingRange": 1.5
                  },
                  "Continue": false,
                  "BodyMotion": {
                    "Type": "Seek",
                    "StopDistance": 1.5,
                    "RelativeSpeed": 0.85,
                    "SlowDownDistance": 1.5
                  }
                },
                {
                  "Sensor": {
                    "Type": "Any"
                  },
                  "Actions": [
                    {
                      "Type": "InteractWithExternalInventory",
                      "SnapshotKey": "Fetch_All",
                      "ActionType": "WITHDRAW",
                      "ConsumeTargetOnSuccess": true
                    }
                  ],
                  "Continue": false,
                  "$Comment": "Fetch Item"
                }
              ],
              "$Comment": "Step 1) Handle Fetch All request"
            },
            {
              "Sensor": {
                "Type": "HasTargetBlockInSnapshot",
                "TargetBlockIds": [
                  "Fetch_Item"
                ]
              },
              "$Comment": "Step 2) Fetch Item",
              "Instructions": [
                {
                  "Sensor": {
                    "Type": "ReachNextTargetInSnapshot",
                    "BlockIds": [
                      "Fetch_Item"
                    ],
                    "StoppingRange": 1.5
                  },
                  "Continue": false,
                  "BodyMotion": {
                    "Type": "Seek",
                    "StopDistance": 1.5,
                    "RelativeSpeed": 0.85,
                    "SlowDownDistance": 1.5
                  }
                },
                {
                  "Sensor": {
                    "Type": "Any"
                  },
                  "Actions": [
                    {
                      "Type": "InteractWithExternalInventory",
                      "SnapshotKey": "Fetch_Item",
                      "ActionType": "WITHDRAW",
                      "ConsumeTargetOnFail": true,
                      "UseSnapshotItemCriteria": true,
                      "ConsumeTargetOnSuccess": true
                    }
                  ],
                  "Continue": false,
                  "$Comment": "Fetch Item"
                }
              ]
            },
            {
              "Sensor": {
                "Type": "HasTargetBlockInSnapshot",
                "TargetBlockIds": [
                  "Dump_All"
                ]
              },
              "$Comment": "Step 3) Handle Drop All request",
              "Instructions": [
                {
                  "Sensor": {
                    "Type": "ReachNextTargetInSnapshot",
                    "BlockIds": [
                      "Dump_All"
                    ],
                    "StoppingRange": 1.5
                  },
                  "Continue": false,
                  "BodyMotion": {
                    "Type": "Seek",
                    "StopDistance": 1.5,
                    "RelativeSpeed": 0.85,
                    "SlowDownDistance": 1.5
                  }
                },
                {
                  "Sensor": {
                    "Type": "Any"
                  },
                  "Actions": [
                    {
                      "Type": "InteractWithExternalInventory",
                      "SnapshotKey": "Dump_All",
                      "ActionType": "DEPOSIT",
                      "ConsumeTargetOnFail": true
                    },
                    {
                      "Type": "ClearSnapshotGroup",
                      "GroupName": "Dump_All",
                      "IfGroupIsEmpty": "Fetch_All"
                    },
                    {
                      "Type": "UpdateStorageRequestStatus",
                      "Status": "COMPLETED"
                    }
                  ],
                  "Continue": false,
                  "$Comment": "Drop All"
                }
              ]
            },
            {
              "Sensor": {
                "Type": "HasTargetBlockInSnapshot",
                "TargetBlockIds": [
                  "Dump_Item"
                ]
              },
              "$Comment": "Step 4) Dump Item",
              "Instructions": [
                {
                  "Sensor": {
                    "Type": "ReachNextTargetInSnapshot",
                    "BlockIds": [
                      "Dump_Item"
                    ],
                    "StoppingRange": 1.5
                  },
                  "Continue": false,
                  "BodyMotion": {
                    "Type": "Seek",
                    "StopDistance": 1.5,
                    "RelativeSpeed": 0.85,
                    "SlowDownDistance": 1.5
                  }
                },
                {
                  "Sensor": {
                    "Type": "Any"
                  },
                  "Actions": [
                    {
                      "Type": "InteractWithExternalInventory",
                      "SnapshotKey": "Dump_Item",
                      "ActionType": "DEPOSIT",
                      "ConsumeTargetOnFail": true,
                      "ConsumeTargetOnSuccess": true,
                      "UseSnapshotItemCriteria": true
                    },
                    {
                      "Type": "ClearSnapshotGroup",
                      "GroupName": "Dump_Item",
                      "IfGroupIsEmpty": "Fetch_Item"
                    },
                    {
                      "Type": "UpdateStorageRequestStatus",
                      "Status": "COMPLETED"
                    }
                  ],
                  "Continue": false,
                  "$Comment": "Drop Item"
                }
              ]
            },
            {
              "Sensor": {
                "Type": "And",
                "Sensors": [
                  {
                    "Type": "Not",
                    "Sensor": {
                      "Type": "HasTargetBlockInSnapshot",
                      "TargetBlockIds": [
                        "Fetch_All"
                      ]
                    }
                  },
                  {
                    "Type": "Not",
                    "Sensor": {
                      "Type": "HasTargetBlockInSnapshot",
                      "TargetBlockIds": [
                        "Fetch_Item"
                      ]
                    }
                  },
                  {
                    "Type": "Not",
                    "Sensor": {
                      "Type": "HasTargetBlockInSnapshot",
                      "TargetBlockIds": [
                        "Dump_All"
                      ]
                    }
                  },
                  {
                    "Type": "Not",
                    "Sensor": {
                      "Type": "HasTargetBlockInSnapshot",
                      "TargetBlockIds": [
                        "Dump_Item"
                      ]
                    }
                  }
                ]
              },
              "$Comment": "No valid transfer target remains for the assigned request",
              "Instructions": [
                {
                  "Sensor": {
                    "Type": "Any"
                  },
                  "Actions": [
                    {
                      "Type": "UpdateStorageRequestStatus",
                      "Status": "REJECTED"
                    },
                    {
                      "Type": "State",
                      "State": "WorkCooldown"
                    }
                  ],
                  "Continue": false
                }
              ]
            },
            {
              "Sensor": {
                "Type": "Any"
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": "WorkCooldown"
                }
              ]
            }
          ],
          "$Comment": "Working"
        },
        {
          "Sensor": {
            "Type": "State",
            "State": ".NoWorkingAreaSnapshot"
          },
          "$Comment": "Needs to process the working enviroment",
          "Instructions": [
            {
              "Sensor": {
                "Type": "Not",
                "Sensor": {
                  "Type": "HasValidWorkAraSnapshot"
                }
              },
              "Actions": [
                {
                  "Type": "ScanWorkArea"
                }
              ],
              "$Comment": "If not valid work area snapshot is present"
            },
            {
              "Sensor": {
                "Type": "Any"
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": ".WorkLoop"
                }
              ],
              "$Comment": "Change Substate: -> .WorkLoop"
            }
          ]
        }
      ],
      "Continue": true,
      "$Comment": "Work Process"
    },
    {
      "Sensor": {
        "Type": "State",
        "State": "WorkCooldown"
      },
      "$Comment": "After all the steps are done",
      "Instructions": [
        {
          "Sensor": {
            "Type": "Any"
          },
          "Continue": true,
          "Actions": [
            {
              "Type": "EquipItemFromInventory",
              "ItemToEquip": "NULL"
            }
          ],
          "$Comment": "Empty the hand"
        },
        {
          "Sensor": {
            "Type": "ReachWorkplace",
            "StoppingRange": 1
          },
          "Actions": [
            {
              "Type": "PlayAnimation",
              "Slot": "Action",
              "Animation": "Walk",
              "Once": true
            }
          ],
          "BodyMotion": {
            "Type": "Seek",
            "SlowDownDistance": 1,
            "StopDistance": 0.8,
            "RelativeSpeed": 1
          },
          "Continue": false,
          "$Comment": "Reaching workplace"
        },
        {
          "Sensor": {
            "Type": "Any"
          },
          "$Comment": "Cooldown",
          "ActionsBlocking": true,
          "ActionsAtomic": true,
          "Actions": [
            {
              "Type": "Timeout",
              "Delay": [
                3,
                5
              ],
              "Action": {
                "Type": "State",
                "State": "PostWorkCooldown"
              }
            }
          ]
        }
      ]
    },
    {
      "Sensor": {
        "Type": "State",
        "State": "PostWorkCooldown"
      },
      "$Comment": "Post Cooldown Creating Snapshot Area",
      "Instructions": [
        {
          "Sensor": {
            "Type": "Any"
          },
          "Actions": [
            {
              "Type": "ScanWorkArea"
            }
          ],
          "Continue": true
        },
        {
          "Sensor": {
            "Type": "Any"
          },
          "Actions": [
            {
              "Type": "State",
              "State": "Working.PreWorkLoop"
            }
          ]
        }
      ]
    }
  ],
  "NameTranslationKey": {
    "Compute": "NameTranslationKey"
  },
  "StartState": "Working",
  "FirstWorkSessionTimeRange": {
    "Compute": "FirstWorkSessionTimeRange"
  },
  "SecondWorkSessionTimeRange": {
    "Compute": "SecondWorkSessionTimeRange"
  },
  "Appearance": {
    "Compute": "Appearance"
  },
  "MaxHealth": {
    "Compute": "MaxHealth"
  }
}
