{
  "Type": "Abstract",
  "Parameters": {
    "Appearance": {
      "Value": "Player",
      "Description": "Model to be used"
    },
    "DropList": {
      "Value": "Empty",
      "Description": "Drop Items"
    },
    "MaxHealth": {
      "Value": 100,
      "Description": "Max health for the NPC"
    },
    "NameTranslationKey": {
      "Value": "server.npcRoles.Template.name",
      "Description": "Translation key for NPC name display"
    },
    "FirstWorkSessionTimeRange": {
      "Value": [
        6,
        11.59
      ],
      "Description": "Time range of the first session"
    },
    "SecondWorkSessionTimeRange": {
      "Value": [
        14,
        16.59
      ],
      "Description": "Time range of the second session"
    }
  },
  "DropList": {
    "Compute": "DropList"
  },
  "MotionControllerList": [
    {
      "Type": "Walk",
      "MaxWalkSpeed": 6,
      "Gravity": 10,
      "MaxFallSpeed": 15,
      "Acceleration": 10
    }
  ],
  "Instructions": [
    {
      "Sensor": {
        "Type": "Not",
        "Sensor": {
          "Type": "WatchForJobAssignment"
        }
      },
      "Instructions": [
        {
          "Sensor": {
            "Type": "Any"
          },
          "Actions": [
            {
              "Type": "Role",
              "Role": "Base_Civilian",
              "ChangeAppearance": false,
              "State": "Normal"
            }
          ],
          "$Comment": "Change State -> Base_Civilian.Panic"
        }
      ],
      "Continue": true,
      "$Comment": "Check if job was removed"
    },
    {
      "Sensor": {
        "Type": "WatchVillageState",
        "State": "panic"
      },
      "Instructions": [
        {
          "Sensor": {
            "Type": "Any"
          },
          "Actions": [
            {
              "Type": "Role",
              "Role": "Base_Civilian",
              "ChangeAppearance": false,
              "State": "Panic"
            }
          ],
          "$Comment": "Change State -> Base_Civilian.Panic"
        }
      ],
      "Continue": true,
      "$Comment": "If the village is in panic"
    },
    {
      "Sensor": {
        "Type": "And",
        "Sensors": [
          {
            "Type": "Not",
            "Sensor": {
              "Type": "TimeInRange",
              "Period": {
                "Compute": "FirstWorkSessionTimeRange"
              }
            }
          },
          {
            "Type": "Not",
            "Sensor": {
              "Type": "TimeInRange",
              "Period": {
                "Compute": "SecondWorkSessionTimeRange"
              }
            }
          }
        ]
      },
      "$Comment": "If is not work time",
      "Instructions": [
        {
          "Sensor": {
            "Type": "Any"
          },
          "Actions": [
            {
              "Type": "Role",
              "Role": "Base_Civilian",
              "ChangeAppearance": false,
              "State": "Normal"
            }
          ],
          "$Comment": "Change State -> Base_Civilian.Normal"
        }
      ],
      "Continue": true
    },
    {
      "Sensor": {
        "Type": "State",
        "State": "Working"
      },
      "Instructions": [
        {
          "Sensor": {
            "Type": "State",
            "State": ".Default"
          },
          "Actions": [
            {
              "Type": "State",
              "State": ".ReachWorkplace"
            }
          ],
          "$Comment": "Entry point"
        },
        {
          "Sensor": {
            "Type": "State",
            "State": ".ReachWorkplace"
          },
          "Instructions": [
            {
              "Sensor": {
                "Type": "ReachWorkplace"
              },
              "Actions": [
                {
                  "Type": "PlayAnimation",
                  "Slot": "Action",
                  "Animation": "Walk",
                  "Once": true
                }
              ],
              "BodyMotion": {
                "Type": "Seek",
                "SlowDownDistance": 1,
                "StopDistance": 1,
                "RelativeSpeed": 1
              },
              "Continue": false,
              "$Comment": "Reaching workplace"
            },
            {
              "Sensor": {
                "Type": "Not",
                "Sensor": {
                  "Type": "HasValidWorkAraSnapshot"
                }
              },
              "Instructions": [
                {
                  "Sensor": {
                    "Type": "Any"
                  },
                  "Actions": [
                    {
                      "Type": "State",
                      "State": ".NoWorkingAreaSnapshot"
                    }
                  ],
                  "$Comment": "Change Substate: Default -> .NoWorkingAreaSnapshot",
                  "Continue": true
                }
              ],
              "$Comment": "No valid work area snapshot",
              "Continue": true
            },
            {
              "Sensor": {
                "Type": "Any"
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": ".WorkLoop"
                }
              ],
              "$Comment": "Workplace Reached -> .StartWork"
            }
          ],
          "$Comment": "Starting the workday"
        },
        {
          "Sensor": {
            "Type": "State",
            "State": ".WorkLoop"
          },
          "Instructions": [
            {
              "Sensor": {
                "Type": "HasTargetBlockInSnapshot",
                "TargetBlockIds": [
                  "Fetch_All"
                ]
              },
              "Instructions": [
                {
                  "Sensor": {
                    "Type": "Not",
                    "Sensor": {
                      "Type": "QueryInventorySensor"
                    }
                  },
                  "Instructions": [
                    {
                      "Sensor": {
                        "Type": "Any"
                      },
                      "Actions": [
                        {
                          "Type": "Log",
                          "Message": "Needs to free up inventory"
                        }
                      ]
                    }
                  ]
                },
                {
                  "Sensor": {
                    "Type": "ReachNextTargetInSnapshot",
                    "BlockIds": [
                      "Fetch_All"
                    ],
                    "StoppingRange": 1
                  },
                  "Continue": false,
                  "BodyMotion": {
                    "Type": "Seek",
                    "StopDistance": 1,
                    "RelativeSpeed": 0.6,
                    "SlowDownDistance": 1
                  }
                },
                {
                  "Sensor": {
                    "Type": "Any"
                  },
                  "Actions": [
                    {
                      "Type": "InteractWithExternalInventory",
                      "SnapshotKey": "Fetch_All",
                      "ActionType": "WITHDRAW"
                    }
                  ],
                  "Continue": true
                },
                {
                  "Sensor": {
                    "Type": "Any"
                  },
                  "Actions": [
                    {
                      "Type": "Log",
                      "Message": "Inventory free, ready to rock"
                    }
                  ],
                  "Continue": true
                }
              ]
            },
            {
              "Sensor": {
                "Type": "Any"
              },
              "Actions": [
                {
                  "Type": "Log",
                  "Message": "Work is done"
                }
              ],
              "Continue": true
            },
            {
              "Sensor": {
                "Type": "Any"
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": "WorkCooldown"
                }
              ]
            }
          ]
        },
        {
          "Sensor": {
            "Type": "State",
            "State": ".NoWorkingAreaSnapshot"
          },
          "$Comment": "Needs to process the working enviroment",
          "Instructions": [
            {
              "Sensor": {
                "Type": "Not",
                "Sensor": {
                  "Type": "HasValidWorkAraSnapshot"
                }
              },
              "Actions": [
                {
                  "Type": "ScanWorkArea"
                }
              ],
              "$Comment": "If not valid work area snapshot is present"
            },
            {
              "Sensor": {
                "Type": "Any"
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": ".WorkLoop"
                }
              ],
              "$Comment": "Change Substate: -> .WorkLoop"
            }
          ]
        }
      ],
      "Continue": true,
      "$Comment": "Work Process"
    },
    {
      "Sensor": {
        "Type": "State",
        "State": "WorkCooldown"
      },
      "$Comment": "After all the steps are done",
      "Instructions": [
        {
          "Sensor": {
            "Type": "Any"
          },
          "Continue": true,
          "Actions": [
            {
              "Type": "EquipItemFromInventory",
              "ItemToEquip": "NULL"
            }
          ],
          "$Comment": "Empty the hand"
        },
        {
          "Sensor": {
            "Type": "Any"
          },
          "$Comment": "Cooldown",
          "ActionsBlocking": true,
          "ActionsAtomic": true,
          "Actions": [
            {
              "Type": "Timeout",
              "Delay": [
                5,
                5
              ],
              "Action": {
                "Type": "State",
                "State": "PostWorkCooldown"
              }
            }
          ]
        }
      ]
    },
    {
      "Sensor": {
        "Type": "State",
        "State": "PostWorkCooldown"
      },
      "$Comment": "Post Cooldown Creating Snapshot Area",
      "Instructions": [
        {
          "Sensor": {
            "Type": "Any"
          },
          "Actions": [
            {
              "Type": "ScanWorkArea"
            }
          ],
          "Continue": true
        },
        {
          "Sensor": {
            "Type": "Any"
          },
          "Actions": [
            {
              "Type": "State",
              "State": "Working.WorkLoop"
            }
          ]
        }
      ]
    }
  ],
  "NameTranslationKey": {
    "Compute": "NameTranslationKey"
  },
  "StartState": "Working",
  "FirstWorkSessionTimeRange": {
    "Compute": "FirstWorkSessionTimeRange"
  },
  "SecondWorkSessionTimeRange": {
    "Compute": "SecondWorkSessionTimeRange"
  },
  "Appearance": {
    "Compute": "Appearance"
  },
  "MaxHealth": {
    "Compute": "MaxHealth"
  }
}
