{
  "Type": "Abstract",
  "Parameters": {
    "Appearance": {
      "Value": "Player",
      "Description": "Model to be used"
    },
    "DropList": {
      "Value": "Empty",
      "Description": "Drop Items"
    },
    "MaxHealth": {
      "Value": 100,
      "Description": "Max health for the NPC"
    },
    "NameTranslationKey": {
      "Value": "server.npcRoles.Template.name",
      "Description": "Translation key for NPC name display"
    },
    "FirstWorkSessionTimeRange": {
      "Value": [
        6,
        11.59
      ],
      "Description": "Time range of the first session"
    },
    "SecondWorkSessionTimeRange": {
      "Value": [
        14,
        16.59
      ],
      "Description": "Time range of the second session"
    }
  },
  "DropList": {
    "Compute": "DropList"
  },
  "MotionControllerList": [
    {
      "Type": "Walk",
      "MaxWalkSpeed": 6,
      "Gravity": 10,
      "MaxFallSpeed": 15,
      "Acceleration": 10
    }
  ],
  "Instructions": [
    {
      "Sensor": {
        "Type": "Not",
        "Sensor": {
          "Type": "WatchForJobAssignment"
        }
      },
      "Instructions": [
        {
          "Sensor": {
            "Type": "Any"
          },
          "Actions": [
            {
              "Type": "Role",
              "Role": "Base_Civilian",
              "ChangeAppearance": false,
              "State": "Normal"
            }
          ],
          "$Comment": "Change State -> Base_Civilian.Panic"
        }
      ],
      "Continue": true,
      "$Comment": "Check if job was removed"
    },
    {
      "Sensor": {
        "Type": "WatchVillageState",
        "State": "panic"
      },
      "Instructions": [
        {
          "Sensor": {
            "Type": "Any"
          },
          "Actions": [
            {
              "Type": "Role",
              "Role": "Base_Civilian",
              "ChangeAppearance": false,
              "State": "Panic"
            }
          ],
          "$Comment": "Change State -> Base_Civilian.Panic"
        }
      ],
      "Continue": true,
      "$Comment": "If the village is in panic"
    },
    {
      "Sensor": {
        "Type": "And",
        "Sensors": [
          {
            "Type": "Not",
            "Sensor": {
              "Type": "TimeInRange",
              "Period": {
                "Compute": "FirstWorkSessionTimeRange"
              }
            }
          },
          {
            "Type": "Not",
            "Sensor": {
              "Type": "TimeInRange",
              "Period": {
                "Compute": "SecondWorkSessionTimeRange"
              }
            }
          }
        ]
      },
      "$Comment": "If is not work time",
      "Instructions": [
        {
          "Sensor": {
            "Type": "Any"
          },
          "Actions": [
            {
              "Type": "Role",
              "Role": "Base_Civilian",
              "ChangeAppearance": false,
              "State": "Normal"
            }
          ],
          "$Comment": "Change State -> Base_Civilian.Normal"
        }
      ],
      "Continue": true
    },
    {
      "Sensor": {
        "Type": "State",
        "State": "Working"
      },
      "Instructions": [
        {
          "Sensor": {
            "Type": "State",
            "State": ".Default"
          },
          "Actions": [
            {
              "Type": "State",
              "State": ".ReachWorkplace"
            }
          ],
          "$Comment": "Entry point"
        },
        {
          "Sensor": {
            "Type": "State",
            "State": ".ReachWorkplace"
          },
          "Instructions": [
            {
              "Sensor": {
                "Type": "ReachWorkplace",
                "StoppingRange": 1
              },
              "Actions": [
                {
                  "Type": "PlayAnimation",
                  "Slot": "Action",
                  "Animation": "Walk",
                  "Once": true
                }
              ],
              "BodyMotion": {
                "Type": "Seek",
                "SlowDownDistance": 1,
                "StopDistance": 0.8,
                "RelativeSpeed": 1
              },
              "Continue": false,
              "$Comment": "Reaching workplace"
            },
            {
              "Sensor": {
                "Type": "Not",
                "Sensor": {
                  "Type": "HasValidWorkAraSnapshot"
                },
                "Once": true
              },
              "$Comment": "If not valid work area snapshot is present",
              "Instructions": [
                {
                  "Sensor": {
                    "Type": "Any"
                  },
                  "Actions": [
                    {
                      "Type": "ScanWorkArea"
                    }
                  ]
                }
              ]
            },
            {
              "Sensor": {
                "Type": "Any"
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": ".PreWorkLoop"
                }
              ],
              "$Comment": "Workplace Reached -> .PreWorkLoop"
            }
          ],
          "$Comment": "Starting the work routine"
        },
        {
          "Sensor": {
            "Type": "State",
            "State": ".PreWorkLoop"
          },
          "$Comment": "Pre WorkLoop - clear inventory",
          "Instructions": [
            {
              "Sensor": {
                "Type": "And",
                "Sensors": [
                  {
                    "Type": "IsBossWorker"
                  },
                  {
                    "Type": "Not",
                    "Sensor": {
                      "Type": "HasANewMealToPrepare"
                    }
                  }
                ],
                "Once": true
              },
              "Actions": [
                {
                  "Type": "CreateNewMealPlanAction",
                  "MealBuffer": 2,
                  "SuccessFlag": "InnKeeperMealPlanReady",
                  "FailureFlag": "InnKeeperMealPlanFailed"
                }
              ],
              "$Comment": "If is the boss and there is no meal plan",
              "Continue": true
            },
            {
              "Sensor": {
                "Type": "Flag",
                "Name": "InnKeeperMealPlanReady",
                "Set": true
              },
              "Actions": [
                {
                  "Type": "Log",
                  "Message": "READY TO WORK"
                },
                {
                  "Type": "SetFlag",
                  "Name": "InnKeeperMealPlanReady",
                  "SetTo": false
                }
              ],
              "Continue": true,
              "$Comment": "Success branch after CreateNewMealPlanAction"
            },
            {
              "Sensor": {
                "Type": "Flag",
                "Name": "InnKeeperMealPlanFailed",
                "Set": true
              },
              "Continue": false,
              "$Comment": "Failure branch after CreateNewMealPlanAction",
              "Actions": [
                {
                  "Type": "Log",
                  "Message": "NOT COMPLETED: Not enough food in storage"
                },
                {
                  "Type": "SetFlag",
                  "Name": "InnKeeperMealPlanFailed",
                  "SetTo": false
                },
                {
                  "Type": "State",
                  "State": "AskStorageForSupply"
                }
              ]
            },
            {
              "Sensor": {
                "Type": "Any"
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": ".WorkLoop"
                }
              ],
              "$Comment": "Substate change: -> .WorkLoop"
            }
          ]
        },
        {
          "Sensor": {
            "Type": "State",
            "State": ".WorkLoop"
          },
          "Instructions": [
            {
              "Sensor": {
                "Type": "HasANewMealToPrepare",
                "AssignMealToSelf": true
              },
              "Instructions": [
                {
                  "Sensor": {
                    "Type": "Any"
                  },
                  "Actions": [
                    {
                      "Type": "State",
                      "State": ".GatherMaterials"
                    }
                  ]
                }
              ]
            },
            {
              "Sensor": {
                "Type": "Any"
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": "WorkCooldown"
                }
              ]
            }
          ],
          "$Comment": "Working"
        },
        {
          "Sensor": {
            "Type": "State",
            "State": ".GatherMaterials"
          },
          "Instructions": [
            {
              "Sensor": {
                "Type": "Not",
                "Sensor": {
                  "Type": "HasTargetBlockInSnapshot",
                  "TargetBlockIds": [
                    "Worker_Workplace_Storage"
                  ]
                }
              },
              "Instructions": [
                {
                  "Sensor": {
                    "Type": "Any"
                  },
                  "Actions": [
                    {
                      "Type": "SetWorkplaceStorageTargetInSnapshot",
                      "ActionType": "ADD"
                    }
                  ],
                  "$Comment": "Set Workplace Storage Target in snapshot"
                }
              ],
              "$Comment": "If he does not know where the storage containers are"
            },
            {
              "Sensor": {
                "Type": "ReachNextTargetInSnapshot",
                "BlockIds": [
                  "Worker_Workplace_Storage"
                ],
                "StoppingRange": 1
              },
              "$Comment": "Reach workplace storage",
              "BodyMotion": {
                "Type": "Seek",
                "SlowDownDistance": 1,
                "StopDistance": 0.9,
                "RelativeSpeed": 0.5
              }
            },
            {
              "Sensor": {
                "Type": "Any"
              },
              "Actions": [
                {
                  "Type": "GatherNextMealMaterialFromContainer",
                  "SuccessFlag": "GatherSuccessful",
                  "FailureFlag": "GatherIncomplete"
                }
              ],
              "$Comment": "Gather material",
              "Continue": true
            },
            {
              "Sensor": {
                "Type": "Flag",
                "Name": "GatherSuccessful",
                "Set": true
              },
              "Actions": [
                {
                  "Type": "Log",
                  "Message": "READY TO WORK"
                },
                {
                  "Type": "SetFlag",
                  "Name": "GatherSuccessful",
                  "SetTo": false
                },
                {
                  "Type": "State",
                  "State": ".Cooking"
                }
              ],
              "Continue": true,
              "$Comment": "Success gather"
            },
            {
              "Sensor": {
                "Type": "Flag",
                "Name": "GatherIncomplete",
                "Set": true
              },
              "Continue": false,
              "$Comment": "Failure Gather",
              "Actions": [
                {
                  "Type": "SetFlag",
                  "Name": "GatherIncomplete",
                  "SetTo": false
                }
              ]
            },
            {
              "Sensor": {
                "Type": "Any"
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": ".Cooking"
                }
              ]
            }
          ],
          "$Comment": "Gather material to cook"
        },
        {
          "Sensor": {
            "Type": "State",
            "State": ".Cooking"
          },
          "Instructions": [
            {
              "Sensor": {
                "Type": "ReachWorkplace",
                "StoppingRange": 1
              },
              "Actions": [
                {
                  "Type": "PlayAnimation",
                  "Slot": "Action",
                  "Animation": "Walk",
                  "Once": true
                }
              ],
              "BodyMotion": {
                "Type": "Seek",
                "SlowDownDistance": 1,
                "StopDistance": 0.8,
                "RelativeSpeed": 1
              },
              "Continue": false,
              "$Comment": "Reaching workplace"
            },
            {
              "Sensor": {
                "Type": "Any"
              },
              "Actions": [
                {
                  "Type": "Timeout",
                  "Delay": [
                    5,
                    5
                  ],
                  "Action": {
                    "Type": "Sequence",
                    "Actions": [
                      {
                        "Type": "CookMeal"
                      },
                      {
                        "Type": "State",
                        "State": ".PlaceCookedFoodOnPlate"
                      }
                    ]
                  }
                }
              ],
              "$Comment": "Cook meal"
            }
          ],
          "$Comment": "Cooking"
        },
        {
          "Sensor": {
            "Type": "State",
            "State": ".PlaceCookedFoodOnPlate"
          },
          "Instructions": [
            {
              "Sensor": {
                "Type": "Any",
                "Once": true
              },
              "$Comment": "Hold Cooked item",
              "Actions": [
                {
                  "Type": "EquipItemFromInventory",
                  "ItemToEquip": "Village_Food"
                }
              ]
            },
            {
              "Sensor": {
                "Type": "Not",
                "Sensor": {
                  "Type": "ReserveNextPlateToFill"
                }
              },
              "Actions": [
                {
                  "Type": "Log",
                  "Message": "NO PLATE TO FILL"
                },
                {
                  "Type": "State",
                  "State": ".NoFreePlateAvailable"
                }
              ]
            },
            {
              "Sensor": {
                "Type": "ReachPlateToFill",
                "StoppingRange": 1.8
              },
              "$Comment": "Reach plate to fill",
              "BodyMotion": {
                "Type": "Seek",
                "StopDistance": 0.8,
                "SlowDownDistance": 1,
                "RelativeSpeed": 0.5
              }
            },
            {
              "Sensor": {
                "Type": "Any",
                "Once": true
              },
              "Actions": [
                {
                  "Type": "PlaceFoodOnPlate"
                }
              ],
              "$Comment": "Try to place item and change state"
            },
            {
              "Sensor": {
                "Type": "Any"
              },
              "$Comment": "If could not place block move forward",
              "Actions": [
                {
                  "Type": "State",
                  "State": ".WorkLoop"
                }
              ]
            }
          ],
          "$Comment": "Cooking"
        },
        {
          "Sensor": {
            "Type": "State",
            "State": ".NoFreePlateAvailable"
          },
          "Instructions": [
            {
              "Sensor": {
                "Type": "QueryDirtyInventorySensor"
              },
              "$Comment": "Deposit cooked meals and leftover materials into workplace storage",
              "Instructions": [
                {
                  "Sensor": {
                    "Type": "Not",
                    "Sensor": {
                      "Type": "HasTargetBlockInSnapshot",
                      "TargetBlockIds": [
                        "Worker_Workplace_Storage"
                      ]
                    },
                    "Once": true
                  },
                  "$Comment": "If the positions of the workplace containers are not in snapshot",
                  "Instructions": [
                    {
                      "Sensor": {
                        "Type": "Any"
                      },
                      "$Comment": "Add workplace containers to snapshot",
                      "Actions": [
                        {
                          "Type": "SetWorkplaceStorageTargetInSnapshot",
                          "ActionType": "ADD"
                        }
                      ]
                    }
                  ]
                },
                {
                  "Sensor": {
                    "Type": "ReachNextTargetInSnapshot",
                    "BlockIds": [
                      "Worker_Workplace_Storage"
                    ],
                    "StoppingRange": 1.5
                  },
                  "$Comment": "Reach workplace storage container",
                  "BodyMotion": {
                    "Type": "Seek",
                    "SlowDownDistance": 1.5,
                    "StopDistance": 1.5,
                    "RelativeSpeed": 0.6
                  }
                },
                {
                  "Sensor": {
                    "Type": "Any"
                  },
                  "$Comment": "Deposit everything carried into workplace storage",
                  "Actions": [
                    {
                      "Type": "InteractWithExternalInventory",
                      "ActionType": "DEPOSIT",
                      "SnapshotKey": "Worker_Workplace_Storage",
                      "ConsumeTargetOnFail": true
                    }
                  ]
                }
              ]
            },
            {
              "Sensor": {
                "Type": "Any"
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": ".WorkLoop"
                }
              ]
            }
          ],
          "$Comment": "Cooking"
        }
      ],
      "Continue": true,
      "$Comment": "Work Process"
    },
    {
      "Sensor": {
        "Type": "State",
        "State": "WorkCooldown"
      },
      "$Comment": "After all the steps are done",
      "Instructions": [
        {
          "Sensor": {
            "Type": "Any"
          },
          "Continue": true,
          "Actions": [
            {
              "Type": "EquipItemFromInventory",
              "ItemToEquip": "NULL"
            }
          ],
          "$Comment": "Empty the hand"
        },
        {
          "Sensor": {
            "Type": "QueryDirtyInventorySensor"
          },
          "$Comment": "Deposit cooked meals and leftover materials into workplace storage",
          "Instructions": [
            {
              "Sensor": {
                "Type": "Not",
                "Sensor": {
                  "Type": "HasTargetBlockInSnapshot",
                  "TargetBlockIds": [
                    "Worker_Workplace_Storage"
                  ]
                },
                "Once": true
              },
              "$Comment": "If the positions of the workplace containers are not in snapshot",
              "Instructions": [
                {
                  "Sensor": {
                    "Type": "Any"
                  },
                  "$Comment": "Add workplace containers to snapshot",
                  "Actions": [
                    {
                      "Type": "SetWorkplaceStorageTargetInSnapshot",
                      "ActionType": "ADD"
                    }
                  ]
                }
              ]
            },
            {
              "Sensor": {
                "Type": "ReachNextTargetInSnapshot",
                "BlockIds": [
                  "Worker_Workplace_Storage"
                ],
                "StoppingRange": 1.5
              },
              "$Comment": "Reach workplace storage container",
              "BodyMotion": {
                "Type": "Seek",
                "SlowDownDistance": 1.5,
                "StopDistance": 1.5,
                "RelativeSpeed": 0.6
              }
            },
            {
              "Sensor": {
                "Type": "Any"
              },
              "$Comment": "Deposit everything carried into workplace storage",
              "Actions": [
                {
                  "Type": "InteractWithExternalInventory",
                  "ActionType": "DEPOSIT",
                  "SnapshotKey": "Worker_Workplace_Storage",
                  "ConsumeTargetOnFail": true
                }
              ]
            }
          ]
        },
        {
          "Sensor": {
            "Type": "ReachWorkplace",
            "StoppingRange": 1
          },
          "Actions": [
            {
              "Type": "PlayAnimation",
              "Slot": "Action",
              "Animation": "Walk",
              "Once": true
            }
          ],
          "BodyMotion": {
            "Type": "Seek",
            "SlowDownDistance": 1,
            "StopDistance": 0.8,
            "RelativeSpeed": 1
          },
          "Continue": false,
          "$Comment": "Reaching workplace"
        },
        {
          "Sensor": {
            "Type": "Any"
          },
          "$Comment": "Cooldown",
          "ActionsBlocking": true,
          "ActionsAtomic": true,
          "Actions": [
            {
              "Type": "Timeout",
              "Delay": [
                25,
                25
              ],
              "Action": {
                "Type": "State",
                "State": "PostWorkCooldown"
              }
            }
          ]
        }
      ]
    },
    {
      "Sensor": {
        "Type": "State",
        "State": "AskStorageForSupply"
      },
      "$Comment": "Ask storage for supply",
      "Instructions": [
        {
          "Sensor": {
            "Type": "Any",
            "Once": true
          },
          "Continue": true,
          "$Comment": "Ask for supply",
          "Actions": [
            {
              "Type": "AskStorageToDeliveResources",
              "SourceType": "WORKPLACE"
            },
            {
              "Type": "Log",
              "Message": "CHIAMATO LO STORAGE"
            }
          ]
        },
        {
          "Sensor": {
            "Type": "Any"
          },
          "$Comment": "Change state to waiting",
          "Actions": [
            {
              "Type": "State",
              "State": "WaitingForStorageResponse"
            }
          ]
        }
      ]
    },
    {
      "Sensor": {
        "Type": "State",
        "State": "WaitingForStorageResponse"
      },
      "$Comment": "Ask storage for supply",
      "Instructions": [
        {
          "Sensor": {
            "Type": "Not",
            "Sensor": {
              "Type": "HasStoragePendingRequest"
            }
          },
          "Continue": true,
          "$Comment": "Ask for supply",
          "Actions": [
            {
              "Type": "State",
              "State": "Working.PreWorkLoop"
            }
          ]
        },
        {
          "Sensor": {
            "Type": "Any"
          },
          "Actions": [
            {
              "Type": "Timeout",
              "Delay": [
                4,
                4
              ]
            }
          ]
        }
      ]
    },
    {
      "Sensor": {
        "Type": "State",
        "State": "PostWorkCooldown"
      },
      "$Comment": "Post Cooldown Creating Snapshot Area",
      "Instructions": [
        {
          "Sensor": {
            "Type": "Any"
          },
          "Actions": [
            {
              "Type": "ScanWorkArea"
            }
          ],
          "Continue": true
        },
        {
          "Sensor": {
            "Type": "Any"
          },
          "Actions": [
            {
              "Type": "State",
              "State": "Working.PreWorkLoop"
            }
          ]
        }
      ]
    }
  ],
  "NameTranslationKey": {
    "Compute": "NameTranslationKey"
  },
  "StartState": "Working",
  "FirstWorkSessionTimeRange": {
    "Compute": "FirstWorkSessionTimeRange"
  },
  "SecondWorkSessionTimeRange": {
    "Compute": "SecondWorkSessionTimeRange"
  },
  "Appearance": {
    "Compute": "Appearance"
  },
  "MaxHealth": {
    "Compute": "MaxHealth"
  }
}
