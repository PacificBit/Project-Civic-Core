{
  "Type": "Abstract",
  "Parameters": {
    "Appearance": {
      "Value": "Player",
      "Description": "Model to be used"
    },
    "DropList": {
      "Value": "Empty",
      "Description": "Drop Items"
    },
    "MaxHealth": {
      "Value": 100,
      "Description": "Max health for the NPC"
    },
    "NameTranslationKey": {
      "Value": "server.npcRoles.Template.name",
      "Description": "Translation key for NPC name display"
    },
    "FirstWorkSessionTimeRange": {
      "Value": [
        6,
        11.59
      ],
      "Description": "Time range of the first session"
    },
    "SecondWorkSessionTimeRange": {
      "Value": [
        14,
        16.59
      ],
      "Description": "Time range of the second session"
    }
  },
  "DropList": {
    "Compute": "DropList"
  },
  "MotionControllerList": [
    {
      "Type": "Walk",
      "MaxWalkSpeed": 6,
      "Gravity": 10,
      "MaxFallSpeed": 15,
      "Acceleration": 10
    }
  ],
  "Instructions": [
    {
      "Sensor": {
        "Type": "Not",
        "Sensor": {
          "Type": "WatchForJobAssignment"
        }
      },
      "Instructions": [
        {
          "Sensor": {
            "Type": "Any"
          },
          "Actions": [
            {
              "Type": "Role",
              "Role": "Base_Civilian",
              "ChangeAppearance": false,
              "State": "Normal"
            }
          ],
          "$Comment": "Change State -> Base_Civilian.Panic"
        }
      ],
      "Continue": true,
      "$Comment": "Check if job was removed"
    },
    {
      "Sensor": {
        "Type": "WatchVillageState",
        "State": "panic"
      },
      "Instructions": [
        {
          "Sensor": {
            "Type": "Any"
          },
          "Actions": [
            {
              "Type": "Role",
              "Role": "Base_Civilian",
              "ChangeAppearance": false,
              "State": "Panic"
            }
          ],
          "$Comment": "Change State -> Base_Civilian.Panic"
        }
      ],
      "Continue": true,
      "$Comment": "If the village is in panic"
    },
    {
      "Sensor": {
        "Type": "And",
        "Sensors": [
          {
            "Type": "Not",
            "Sensor": {
              "Type": "TimeInRange",
              "Period": {
                "Compute": "FirstWorkSessionTimeRange"
              }
            }
          },
          {
            "Type": "Not",
            "Sensor": {
              "Type": "TimeInRange",
              "Period": {
                "Compute": "SecondWorkSessionTimeRange"
              }
            }
          }
        ]
      },
      "$Comment": "If is not work time",
      "Instructions": [
        {
          "Sensor": {
            "Type": "Any"
          },
          "Actions": [
            {
              "Type": "Role",
              "Role": "Base_Civilian",
              "ChangeAppearance": false,
              "State": "Normal"
            }
          ],
          "$Comment": "Change State -> Base_Civilian.Normal"
        }
      ],
      "Continue": true
    },
    {
      "Sensor": {
        "Type": "State",
        "State": "Working"
      },
      "Instructions": [
        {
          "Sensor": {
            "Type": "State",
            "State": ".Default"
          },
          "Actions": [
            {
              "Type": "State",
              "State": ".ReachWorkplace"
            }
          ],
          "$Comment": "Entry point"
        },
        {
          "Sensor": {
            "Type": "State",
            "State": ".ReachWorkplace"
          },
          "Instructions": [
            {
              "Sensor": {
                "Type": "ReachWorkplace"
              },
              "Actions": [
                {
                  "Type": "PlayAnimation",
                  "Slot": "Action",
                  "Animation": "Walk",
                  "Once": true
                }
              ],
              "BodyMotion": {
                "Type": "Seek",
                "SlowDownDistance": 1,
                "StopDistance": 1,
                "RelativeSpeed": 1
              },
              "Continue": false,
              "$Comment": "Reaching workplace"
            },
            {
              "Sensor": {
                "Type": "Not",
                "Sensor": {
                  "Type": "HasValidWorkAraSnapshot"
                },
                "Once": true
              },
              "$Comment": "If not valid work area snapshot is present",
              "Instructions": [
                {
                  "Sensor": {
                    "Type": "Any"
                  },
                  "Actions": [
                    {
                      "Type": "ScanWorkArea"
                    }
                  ]
                }
              ]
            },
            {
              "Sensor": {
                "Type": "Any"
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": ".PreWorkLoop"
                }
              ],
              "$Comment": "Workplace Reached -> .PreWorkLoop"
            }
          ],
          "$Comment": "Starting the work routine"
        },
        {
          "Sensor": {
            "Type": "State",
            "State": ".PreWorkLoop"
          },
          "$Comment": "Pre WorkLoop - clear inventory",
          "Instructions": [
            {
              "Sensor": {
                "Type": "And",
                "Sensors": [
                  {
                    "Type": "IsBossWorker"
                  },
                  {
                    "Type": "Not",
                    "Sensor": {
                      "Type": "HasANewMealToPrepare"
                    }
                  }
                ],
                "Once": true
              },
              "Actions": [
                {
                  "Type": "CreateNewMealPlanAction",
                  "SuccessFlag": "InnKeeperMealPlanReady",
                  "FailureFlag": "InnKeeperMealPlanFailed"
                }
              ],
              "$Comment": "If is the boss and there is no meal plan",
              "Continue": true
            },
            {
              "Sensor": {
                "Type": "Flag",
                "Name": "InnKeeperMealPlanReady",
                "Set": true
              },
              "Actions": [
                {
                  "Type": "Log",
                  "Message": "READY TO WORK"
                },
                {
                  "Type": "SetFlag",
                  "Name": "InnKeeperMealPlanReady",
                  "SetTo": false
                }
              ],
              "Continue": true,
              "$Comment": "Success branch after CreateNewMealPlanAction"
            },
            {
              "Sensor": {
                "Type": "Flag",
                "Name": "InnKeeperMealPlanFailed",
                "Set": true
              },
              "Continue": false,
              "$Comment": "Failure branch after CreateNewMealPlanAction",
              "Actions": [
                {
                  "Type": "Log",
                  "Message": "NOT COMPLETED: Not enough food in storage"
                },
                {
                  "Type": "SetFlag",
                  "Name": "InnKeeperMealPlanFailed",
                  "SetTo": false
                },
                {
                  "Type": "State",
                  "State": "WaitingStorageResult"
                }
              ]
            },
            {
              "Sensor": {
                "Type": "Any"
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": ".WorkLoop"
                }
              ],
              "$Comment": "Substate change: -> .WorkLoop"
            }
          ]
        },
        {
          "Sensor": {
            "Type": "State",
            "State": ".WorkLoop"
          },
          "Instructions": [
            {
              "Sensor": {
                "Type": "HasANewMealToPrepare",
                "AssignMealToSelf": true
              },
              "Instructions": [
                {
                  "Sensor": {
                    "Type": "Any"
                  },
                  "Actions": [
                    {
                      "Type": "State",
                      "State": ".GatherMaterials"
                    }
                  ]
                }
              ]
            },
            {
              "Sensor": {
                "Type": "Any"
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": "WorkCooldown"
                }
              ]
            }
          ],
          "$Comment": "Working"
        },
        {
          "Sensor": {
            "Type": "State",
            "State": ".GatherMaterials"
          },
          "Instructions": [
            {
              "Sensor": {
                "Type": "Not",
                "Sensor": {
                  "Type": "HasTargetBlockInSnapshot",
                  "TargetBlockIds": [
                    "Worker_Workplace_Storage"
                  ]
                }
              },
              "Instructions": [
                {
                  "Sensor": {
                    "Type": "Any"
                  },
                  "Actions": [
                    {
                      "Type": "SetWorkplaceStorageTargetInSnapshot",
                      "ActionType": "ADD"
                    }
                  ],
                  "$Comment": "Set Workplace Storage Target in snapshot"
                }
              ],
              "$Comment": "If he does not know where the storage containers are"
            },
            {
              "Sensor": {
                "Type": "ReachNextTargetInSnapshot",
                "BlockIds": [
                  "Worker_Workplace_Storage"
                ],
                "StoppingRange": 1
              },
              "$Comment": "Reach workplace storage",
              "BodyMotion": {
                "Type": "Seek",
                "SlowDownDistance": 1,
                "StopDistance": 1,
                "RelativeSpeed": 0.5
              }
            },
            {
              "Sensor": {
                "Type": "Any"
              },
              "Actions": [
                {
                  "Type": "GatherNextMealMaterialFromContainer"
                }
              ],
              "$Comment": "Gather material"
            },
            {
              "Sensor": {
                "Type": "Any"
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": ".Cooking"
                }
              ]
            }
          ],
          "$Comment": "Gather material to cook"
        },
        {
          "Sensor": {
            "Type": "State",
            "State": ".Cooking"
          },
          "Instructions": [
            {
              "Sensor": {
                "Type": "Any"
              },
              "$Comment": "Reach workplace storage",
              "BodyMotion": {
                "Type": "Nothing"
              }
            }
          ],
          "$Comment": "Cooking"
        }
      ],
      "Continue": true,
      "$Comment": "Work Process"
    },
    {
      "Sensor": {
        "Type": "State",
        "State": "WorkCooldown"
      },
      "$Comment": "After all the steps are done",
      "Instructions": [
        {
          "Sensor": {
            "Type": "Any"
          },
          "Continue": true,
          "Actions": [
            {
              "Type": "EquipItemFromInventory",
              "ItemToEquip": "NULL"
            }
          ],
          "$Comment": "Empty the hand"
        },
        {
          "Sensor": {
            "Type": "ReachWorkplace"
          },
          "Actions": [
            {
              "Type": "PlayAnimation",
              "Slot": "Action",
              "Animation": "Walk",
              "Once": true
            }
          ],
          "BodyMotion": {
            "Type": "Seek",
            "SlowDownDistance": 1,
            "StopDistance": 1,
            "RelativeSpeed": 1
          },
          "Continue": false,
          "$Comment": "Reaching workplace"
        },
        {
          "Sensor": {
            "Type": "Any"
          },
          "$Comment": "Cooldown",
          "ActionsBlocking": true,
          "ActionsAtomic": true,
          "Actions": [
            {
              "Type": "Timeout",
              "Delay": [
                25,
                25
              ],
              "Action": {
                "Type": "State",
                "State": "PostWorkCooldown"
              }
            }
          ]
        }
      ]
    },
    {
      "Sensor": {
        "Type": "State",
        "State": "WaitingStorageResult"
      },
      "$Comment": "Ask storage for supply",
      "Instructions": [
        {
          "Sensor": {
            "Type": "Any"
          },
          "Continue": true,
          "$Comment": "Call the storage",
          "Actions": [
            {
              "Type": "Log",
              "Message": "STO ASPETTANDO LO STORAGE"
            }
          ]
        }
      ]
    },
    {
      "Sensor": {
        "Type": "State",
        "State": "PostWorkCooldown"
      },
      "$Comment": "Post Cooldown Creating Snapshot Area",
      "Instructions": [
        {
          "Sensor": {
            "Type": "Any"
          },
          "Actions": [
            {
              "Type": "ScanWorkArea"
            }
          ],
          "Continue": true
        },
        {
          "Sensor": {
            "Type": "Any"
          },
          "Actions": [
            {
              "Type": "State",
              "State": "Working.PreWorkLoop"
            }
          ]
        }
      ]
    }
  ],
  "NameTranslationKey": {
    "Compute": "NameTranslationKey"
  },
  "StartState": "Working",
  "FirstWorkSessionTimeRange": {
    "Compute": "FirstWorkSessionTimeRange"
  },
  "SecondWorkSessionTimeRange": {
    "Compute": "SecondWorkSessionTimeRange"
  },
  "Appearance": {
    "Compute": "Appearance"
  },
  "MaxHealth": {
    "Compute": "MaxHealth"
  }
}
